{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tokmira",
  "mainBinaryName": "token-audit-desktop",
  "version": "1.3.0",
  "identifier": "app.tokenaudit.desktop",
  "build": {
    "beforeDevCommand": "pnpm -C ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm -C ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tokmira",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 16, "y": 16 },
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "windows": {
      "nsis": { "template": "windows/installer.nsi" }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "externalBin": ["binaries/token-audit"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwQ0ZEMzAzQzcxNTU0Q0IKUldUTFZCWEhBOVBQc0NueFVVUmdHRm5hQlQ3TmZybDU1Q2NaY3ZNbmsrTjYrMEk4WEF3Rng5dVgK",
      "endpoints": ["https://github.com/WenWangxin/Tokmira/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" },
      "requireSignedVersion": true
    }
  }
}
